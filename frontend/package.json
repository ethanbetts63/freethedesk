{
  "name": "freethedesk-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check:sitemap": "node scripts/check-sitemap-routes.mjs",
    "check:seo-ledger": "node scripts/check-indexation-ledger.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:text-scale": "node scripts/sync-text-scale.mjs --check",
    "tokens:text-scale": "node scripts/sync-text-scale.mjs",
    "check": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run check:sitemap && npm run check:seo-ledger && npm run check:tokens && npm run check:text-scale"
  },
  "dependencies": {
    "@freetheplatform/web-security": "github:ethanbetts63/freetheplatform#v0.10.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^4.1.0",
    "marked": "^18.0.4",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~5.9.3"
  }
}
