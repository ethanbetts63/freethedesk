{
  "name": "freethedesk-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:sitemap": "node scripts/check-sitemap-routes.mjs",
    "check:crumbs": "node scripts/check-crumb-labels.mjs",
    "check:seo-ledger": "node scripts/check-indexation-ledger.mjs",
    "check:og-images": "node scripts/check-og-images.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:customer-routes": "node scripts/check-customer-routes.mjs",
    "check:forms": "node scripts/check-forms.mjs",
    "check:baseline": "node scripts/baseline/baseline-drift.mjs",
    "check:text-scale": "node scripts/sync-text-scale.mjs --check",
    "tokens:text-scale": "node scripts/sync-text-scale.mjs",
    "check": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run check:sitemap && npm run check:crumbs && npm run check:seo-ledger && npm run check:og-images && npm run check:customer-routes && npm run check:forms && npm run check:tokens && npm run check:text-scale && npm run check:baseline"
  },
  "dependencies": {
    "@freetheplatform/web-security": "github:ethanbetts63/freetheplatform#v0.29.2",
    "@hookform/resolvers": "^5.9.1",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "marked": "18.0.4",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.88.0",
    "sanitize-html": "2.17.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "prettier": "^3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "5.9.3"
  }
}
