# Django
SECRET_KEY=replace-this-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Set DB_ENGINE=mysql and populate these values when moving off local SQLite.
DB_ENGINE=sqlite
DB_NAME=freethedesk_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Public site and secure-cookie requests
SITE_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Admin enquiry notifications. Keep disabled until the credentials below work.
NOTIFICATIONS_ENABLED=False
ADMIN_EMAIL=you@example.com
ADMIN_NUMBER=+61400000000
DEFAULT_FROM_EMAIL="Free the Desk <hello@freethedesk.com.au>"

# Mailgun email delivery
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Twilio SMS delivery (use a messaging service or a sending number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
